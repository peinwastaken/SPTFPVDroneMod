<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Version>0.7.0</Version>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>FPVDroneModServer</RootNamespace>
        <Configurations>Debug;Release;UNITY_EDITOR</Configurations>
        <Platforms>AnyCPU</Platforms>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="SPTarkov.Server.Core" Version="4.0.3" />
      <PackageReference Include="WTT-ServerCommonLib" Version="2.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildProjectFullPath).user" Condition="Exists('$(MSBuildProjectFullPath).user')" />
    </ItemGroup>

    <PropertyGroup>
        <SPTModType>Server</SPTModType>
    </PropertyGroup>
</Project>
